        <mxCell id="ULqPiB260yUuj6z3zagn-66" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;u&gt;&lt;i&gt;CSR producer row:&lt;/i&gt;&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;u&gt;&lt;i&gt;All cells are don&#39;t care in this dependency K-map.&lt;/i&gt;&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;u&gt;&lt;i&gt;Covered by one CSR serialization case:&lt;/i&gt;&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;u&gt;&lt;i&gt;csr_inflight blocks younger dispatch until CSR P4 commit.&lt;/i&gt;&lt;/u&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="340" x="845" y="518" as="geometry" />
        </mxCell>
        <mxCell id="mbj8eDxTX49YaJQTU72y-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;don&#39;t exist: 这个 producer/dependent 关系在数据语义上不存在&lt;br&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;don&#39;t allow: 数据语义存在，但这个 timing 形态被架构规则禁止&lt;br&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;don&#39;t care: 不在这个 K-map 里展开，另有代表 case 或无新增 timing shape&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="397" x="737" y="50.5" as="geometry" />
        </mxCell>
        <mxCell id="yjgwQ95_MUBzVHDyDSSW-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Conditional BRU without link: Don&#39;t Exist.&lt;/div&gt;&lt;div&gt;JAL/JALR with rd != x0: register-result producer exists, covered by ALU/BRU 1-cycle producer POI.&lt;/div&gt;" vertex="1">
