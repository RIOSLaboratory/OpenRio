# Build and simulation output
# Everything under sim/ is generated by the VCS or Verilator flow.  Only the
# flow Makefile is a source file, so ignore the directory contents and add back
# that one file.  A deny-all pattern keeps the SYS+TAG metadata the VCS flow
# writes directly into sim/<SYS>_<TAG>/ (regression_manifest.json, <tag>_tasks.txt,
# regression.list, regression.sh) and sim/regression_report/ out of git.
/sim/*
!/sim/Makefile
/obj_dir*/
/mock_tb/build/

# Simulator artifacts
*.log
*.fsdb
*.vcd
*.vpd
*.key
ucli.key*
simv
csrc/
novas.*
DVEfiles/
.vcs_lib/

# Python bytecode cache from tools/*.py
__pycache__/
*.pyc

# Local dependency drops
/third_party/
/archive/
