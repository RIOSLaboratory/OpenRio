# Copy this file to env.sh and edit the values for the target host.
# Do not commit env.sh.

# ---------------------------------------------------------------------------
# VCS / Verdi installation roots
# ---------------------------------------------------------------------------
# cad21 and dev2 share this layout.  Note the asymmetry: the VCS installation
# directory is T-2022.06-SP2 (no "-3"), while Verdi is T-2022.06-SP2-3.
# Pointing VCS_HOME at the Verdi directory makes $VCS_HOME/include/svdpi.h
# disappear.
export VCS_HOME=/eda/synopsys/vcs/T-2022.06-SP2
export VERDI_HOME=/eda/synopsys/verdi/T-2022.06-SP2-3

# If svdpi.h is not in $VCS_HOME/include, point this at the directory that
# actually contains svdpi.h (some site wrappers separate the two installs).
# export VCS_INCLUDE_DIR=/eda/synopsys/vcs/T-2022.06-SP2/include

# The Verdi PLI is what makes FSDB possible; check it before debugging a
# missing waveform:
#   ls $VERDI_HOME/share/PLI/VCS/LINUX64/novas.tab $VERDI_HOME/share/PLI/VCS/LINUX64/pli.a

# ---------------------------------------------------------------------------
# ISA model
# ---------------------------------------------------------------------------
# The library must be built on the same host (same glibc) as the simulation.
# Both layouts are auto-detected by the Makefile:
#   build tree   : $ISA_MODEL_ROOT/src/libs/IsaApi.h + $ISA_MODEL_ROOT/build/lib_ISA_api.so
#   install tree : $ISA_MODEL_ROOT/include/IsaApi.h  + $ISA_MODEL_ROOT/lib/lib_ISA_api.so
#
# cad21 (CentOS 7, glibc 2.17) build recipe:
#   cd <function-model>; source env.sh          # exports CC/CXX = gcc14
#   cd $ISA_MODEL_ROOT
#   rm -rf build                                # a stale cache pins the old g++
#   cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
#     -DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX"
#   cmake --build build --parallel
#   objdump -T build/lib_ISA_api.so | grep -oE 'GLIBC_[0-9]+(\.[0-9]+)+' | sort -Vu | tail -1
#
# The header must match the revision verification/or_cosim/dpi/isa_dpi_wrapper.cc
# was written against.  The internal function-model tree moved the BE metadata
# into include/ext/IsaApiExt_BE.h and is NOT interchangeable with this wrapper.
export ISA_MODEL_ROOT=/work/home03/danielle/isa_model_cad21

# ---------------------------------------------------------------------------
# Toolchain
# ---------------------------------------------------------------------------
# The ISA model needs C++20, and the DPI wrapper must link against the same
# libstdc++, so both are compiled with gcc14.  The OS g++ (7.5.0 on CentOS 7)
# cannot compile the model at all.
export CC=/work/home/proj_common/gcc_14_x86/bin/gcc
export CXX=/work/home/proj_common/gcc_14_x86/bin/g++

# simv dlopen()s libisa_dpi.so, which in turn needs this libstdc++ at runtime.
# Keep it on LD_LIBRARY_PATH for the VCS link step and for the simulation.
export LD_LIBRARY_PATH=/work/home/proj_common/gcc_14_x86/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# VCS object databases are slow on NFS; point the build tree at local disk when
# the checkout lives on a network filesystem.
# export VCS_WORK_ROOT=/tmp/$USER/vcs_cosim_sim

export PATH="$VCS_HOME/bin:$VERDI_HOME/bin:$PATH"

echo "[env.sh] VCS_HOME       = $VCS_HOME"
echo "[env.sh] VERDI_HOME     = $VERDI_HOME"
echo "[env.sh] ISA_MODEL_ROOT = $ISA_MODEL_ROOT"
echo "[env.sh] CXX            = $CXX"
echo "[env.sh] LD_LIBRARY_PATH= $LD_LIBRARY_PATH"

